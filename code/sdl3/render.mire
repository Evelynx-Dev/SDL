pub fn create_rect: (x :i64, y :i64, w :i64, h :i64) :i64 {
    set ptr = rt_alloc_raw(16)
    if ptr == 0 { return 0 }
    rt_write_u32(ptr, x)
    rt_write_u32(ptr + 4, y)
    rt_write_u32(ptr + 8, w)
    rt_write_u32(ptr + 12, h)
    return ptr
}

pub fn destroy_rect: (ptr :i64) {
    if ptr != 0 { rt_free_raw(ptr) }
}

extern fn rt_read_u32: (ptr :i64) :i64 lib "c"

pub fn rect_get_x: (rect_ptr :i64) :i64 { return rt_read_u32(rect_ptr) }
pub fn rect_get_y: (rect_ptr :i64) :i64 { return rt_read_u32(rect_ptr + 4) }
pub fn rect_get_w: (rect_ptr :i64) :i64 { return rt_read_u32(rect_ptr + 8) }
pub fn rect_get_h: (rect_ptr :i64) :i64 { return rt_read_u32(rect_ptr + 12) }

pub fn rect_set_x: (rect_ptr :i64, x :i64) { rt_write_u32(rect_ptr, x) }
pub fn rect_set_y: (rect_ptr :i64, y :i64) { rt_write_u32(rect_ptr + 4, y) }
pub fn rect_set_w: (rect_ptr :i64, w :i64) { rt_write_u32(rect_ptr + 8, w) }
pub fn rect_set_h: (rect_ptr :i64, h :i64) { rt_write_u32(rect_ptr + 12, h) }

pub fn render_texture_xywh: (rend :i64, tex :i64, src_x :i64, src_y :i64, src_w :i64, src_h :i64, dst_x :i64, dst_y :i64, dst_w :i64, dst_h :i64) :bool {
    set src = use! render::create_rect(src_x src_y src_w src_h)
    if src == 0 { return false }
    set dst = use! render::create_rect(dst_x dst_y dst_w dst_h)
    if dst == 0 {
        use! render::destroy_rect(src)
        return false
    }
    set ok = SDL_RenderTexture(rend tex src dst)
    use! render::destroy_rect(src)
    use! render::destroy_rect(dst)
    return ok
}

// ── Geometry rendering (SDL_RenderGeometry) ────────────────────────
// SDL_Vertex is 32 bytes: position{f32 x, f32 y} color{f32 r,g,b,a} texcoord{f32 u, f32 v}

pub fn vertex_size: () :i64 { return 32 }

pub fn create_vertex: (x :f64, y :f64, r :f64, g :f64, b :f64, a :f64, u :f64, v :f64) :i64 {
    set ptr = rt_alloc_raw(use! render::vertex_size())
    if ptr == 0 { return 0 }
    use! render::vertex_set_position(ptr, x, y)
    use! render::vertex_set_color(ptr, r, g, b, a)
    use! render::vertex_set_texcoord(ptr, u, v)
    return ptr
}

pub fn vertex_set_position: (ptr :i64, x :f64, y :f64) {
    rt_write_f32(ptr, x)
    rt_write_f32(ptr + 4, y)
}

pub fn vertex_set_color: (ptr :i64, r :f64, g :f64, b :f64, a :f64) {
    rt_write_f32(ptr + 8, r)
    rt_write_f32(ptr + 12, g)
    rt_write_f32(ptr + 16, b)
    rt_write_f32(ptr + 20, a)
}

pub fn vertex_set_texcoord: (ptr :i64, u :f64, v :f64) {
    rt_write_f32(ptr + 24, u)
    rt_write_f32(ptr + 28, v)
}

pub fn render_geometry: (rend :i64, tex :i64, vertices_ptr :i64, num_vertices :i64) :bool {
    return SDL_RenderGeometry(rend, tex, vertices_ptr, num_vertices, 0, 0)
}

// ── FPoint array helpers (for SDL_RenderPoints/Lines) ────────────
// Each SDL_FPoint is 8 bytes: float x, float y

pub fn fpoint_size: () :i64 { return 8 }

pub fn create_fpoint: (x :f64, y :f64) :i64 {
    set ptr = rt_alloc_raw(use! render::fpoint_size())
    if ptr == 0 { return 0 }
    rt_write_f32(ptr, x)
    rt_write_f32(ptr + 4, y)
    return ptr
}

pub fn render_points: (rend :i64, points_ptr :i64, count :i64) :bool {
    return SDL_RenderPoints(rend, points_ptr, count)
}

pub fn render_lines: (rend :i64, points_ptr :i64, count :i64) :bool {
    return SDL_RenderLines(rend, points_ptr, count)
}

// ── Texture lock/unlock for pixel-level access ─────────────────────
// lock_texture: allocates output slots for pixels ptr and pitch, locks the texture,
// and returns the pixel pointer via rt_read_ptr. Pass 0 for rect to lock entire texture.

pub fn lock_texture: (tex :i64) :i64 {
    set pixels_ptr = rt_alloc_raw(8)
    set pitch_ptr = rt_alloc_raw(8)
    set ok = SDL_LockTexture(tex, 0, pixels_ptr, pitch_ptr)
    if !ok {
        rt_free_raw(pixels_ptr)
        rt_free_raw(pitch_ptr)
        return 0
    }
    set pixel_data = rt_read_ptr(pixels_ptr)
    rt_free_raw(pixels_ptr)
    rt_free_raw(pitch_ptr)
    return pixel_data
}

pub fn unlock_texture: (tex :i64) {
    SDL_UnlockTexture(tex)
}

