pub fn texture_access_static: () :i64 { return 0 }
pub fn texture_access_streaming: () :i64 { return 1 }
pub fn texture_access_target: () :i64 { return 2 }

pub fn pixel_format_rgba8888: () :i64 { return 372645892 }
pub fn pixel_format_bgra8888: () :i64 { return 376840196 }
pub fn pixel_format_rgb24: () :i64 { return 386127691 }
pub fn pixel_format_bgr24: () :i64 { return 390331915 }

pub fn blend_mode_none: () :i64 { return 0 }
pub fn blend_mode_blend: () :i64 { return 1 }
pub fn blend_mode_add: () :i64 { return 2 }
pub fn blend_mode_mod: () :i64 { return 4 }
pub fn blend_mode_mul: () :i64 { return 8 }

pub fn logical_presentation_disabled: () :i64 { return 0 }
pub fn logical_presentation_stretch: () :i64 { return 1 }
pub fn logical_presentation_letterbox: () :i64 { return 2 }
pub fn logical_presentation_overscan: () :i64 { return 3 }
pub fn logical_presentation_integer_scale: () :i64 { return 4 }

pub fn color_white: () :i64 {
    set c = rt_alloc_raw(4)
    if c == 0 { return 0 }
    rt_write_u8(c, 255)
    rt_write_u8(c + 1, 255)
    rt_write_u8(c + 2, 255)
    rt_write_u8(c + 3, 255)
    return c
}

pub fn color_red: () :i64 {
    set c = rt_alloc_raw(4)
    if c == 0 { return 0 }
    rt_write_u8(c, 255)
    rt_write_u8(c + 1, 0)
    rt_write_u8(c + 2, 0)
    rt_write_u8(c + 3, 255)
    return c
}

pub fn color_green: () :i64 {
    set c = rt_alloc_raw(4)
    if c == 0 { return 0 }
    rt_write_u8(c, 0)
    rt_write_u8(c + 1, 255)
    rt_write_u8(c + 2, 0)
    rt_write_u8(c + 3, 255)
    return c
}

pub fn color_blue: () :i64 {
    set c = rt_alloc_raw(4)
    if c == 0 { return 0 }
    rt_write_u8(c, 0)
    rt_write_u8(c + 1, 0)
    rt_write_u8(c + 2, 255)
    rt_write_u8(c + 3, 255)
    return c
}

pub fn color_black: () :i64 {
    set c = rt_alloc_raw(4)
    if c == 0 { return 0 }
    rt_write_u8(c, 0)
    rt_write_u8(c + 1, 0)
    rt_write_u8(c + 2, 0)
    rt_write_u8(c + 3, 255)
    return c
}

pub fn color_clear: () :i64 {
    set c = rt_alloc_raw(4)
    if c == 0 { return 0 }
    rt_write_u8(c, 0)
    rt_write_u8(c + 1, 0)
    rt_write_u8(c + 2, 0)
    rt_write_u8(c + 3, 0)
    return c
}

pub fn color_destroy: (color_ptr :i64) {
    if color_ptr != 0 { rt_free_raw(color_ptr) }
}

pub fn color_get_r: (color_ptr :i64) :i64 { return rt_read_u8(color_ptr) }
pub fn color_get_g: (color_ptr :i64) :i64 { return rt_read_u8(color_ptr + 1) }
pub fn color_get_b: (color_ptr :i64) :i64 { return rt_read_u8(color_ptr + 2) }
pub fn color_get_a: (color_ptr :i64) :i64 { return rt_read_u8(color_ptr + 3) }

pub fn color_set_r: (color_ptr :i64, r :i64) { rt_write_u8(color_ptr, r) }
pub fn color_set_g: (color_ptr :i64, g :i64) { rt_write_u8(color_ptr + 1, g) }
pub fn color_set_b: (color_ptr :i64, b :i64) { rt_write_u8(color_ptr + 2, b) }
pub fn color_set_a: (color_ptr :i64, a :i64) { rt_write_u8(color_ptr + 3, a) }

pub fn create_renderer: (win :i64) :i64 {
    return SDL_CreateRenderer(win 0)
}

pub fn destroy_renderer: (rend :i64) { SDL_DestroyRenderer(rend) }

pub fn get_renderer_name: (rend :i64) :str { return SDL_GetRendererName(rend) }

pub fn set_draw_color: (rend :i64, r :i64, g :i64, b :i64, a :i64) :bool {
    return SDL_SetRenderDrawColor(rend r g b a)
}

pub fn get_draw_color: (rend :i64, r :i64, g :i64, b :i64, a :i64) :bool {
    return SDL_GetRenderDrawColor(rend r g b a)
}

pub fn clear: (rend :i64) :bool { return SDL_RenderClear(rend) }

pub fn present: (rend :i64) :bool { return SDL_RenderPresent(rend) }

pub fn fill_screen: (rend :i64, r :i64, g :i64, b :i64) :bool {
    // SDL3 returns `true` on success, so the failure test is a plain negation.
    // The SDL2 spelling of this function, `!= 0` against an `i64` return, does
    // not carry over: these three are declared `:bool`, and `== 0` was a
    // comparison of a bool with an integer, which is a type error.
    if !SDL_SetRenderDrawColor(rend r g b 255) { return false }
    if !SDL_RenderClear(rend) { return false }
    if !SDL_RenderPresent(rend) { return false }
    return true
}

pub fn create_texture: (rend :i64, format :i64, access :i64, w :i64, h :i64) :i64 {
    return SDL_CreateTexture(rend format access w h)
}

pub fn destroy_texture: (tex :i64) { SDL_DestroyTexture(tex) }

pub fn update_texture: (tex :i64, rect_ptr :i64, pixels :i64, pitch :i64) :bool {
    return SDL_UpdateTexture(tex rect_ptr pixels pitch)
}

pub fn render_texture: (rend :i64, tex :i64, src :i64, dst :i64) :bool {
    return SDL_RenderTexture(rend tex src dst)
}

pub fn fill_rect: (rend :i64, rect_ptr :i64) :bool {
    return SDL_RenderFillRect(rend rect_ptr)
}

pub fn fill_rect_xywh: (rend :i64, x :i64, y :i64, w :i64, h :i64) :bool {
    set rect = use! render::create_rect(x y w h)
    if rect == 0 { return false }
    set ok = SDL_RenderFillRect(rend rect)
    use! render::destroy_rect(rect)
    return ok
}

pub fn draw_rect: (rend :i64, rect_ptr :i64) :bool {
    return SDL_RenderRect(rend rect_ptr)
}

pub fn draw_rect_xywh: (rend :i64, x :i64, y :i64, w :i64, h :i64) :bool {
    set rect = use! render::create_rect(x y w h)
    if rect == 0 { return false }
    set ok = SDL_RenderRect(rend rect)
    use! render::destroy_rect(rect)
    return ok
}

