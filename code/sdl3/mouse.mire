module mouse

extern lib "SDL3"

extern fn SDL_HasMouse: () :bool lib "SDL3"
extern fn SDL_GetMice: (count :i64) :i64 lib "SDL3"
extern fn SDL_GetMouseNameForID: (instance_id :i64) :str lib "SDL3"
extern fn SDL_GetMouseState: (x :i64, y :i64) :i64 lib "SDL3"
extern fn SDL_GetGlobalMouseState: (x :i64, y :i64) :i64 lib "SDL3"
extern fn SDL_WarpMouseInWindow: (window :i64, x :f64, y :f64) lib "SDL3"
extern fn SDL_WarpMouseGlobal: (x :f64, y :f64) :bool lib "SDL3"
extern fn SDL_CaptureMouse: (enabled :bool) :bool lib "SDL3"

pub fn has_mouse: () :bool {
    return SDL_HasMouse()
}

pub fn get_mouse_count: () :i64 {
    return SDL_GetMice(0)
}

pub fn get_mouse_name: (id :i64) :str {
    return SDL_GetMouseNameForID(id)
}

pub fn get_mouse_state: (x :i64, y :i64) :i64 {
    return SDL_GetMouseState(x, y)
}

pub fn get_global_mouse_state: (x :i64, y :i64) :i64 {
    return SDL_GetGlobalMouseState(x, y)
}

pub fn warp_mouse_in_window: (win :i64, x :f64, y :f64) {
    SDL_WarpMouseInWindow(win, x, y)
}

pub fn warp_mouse_global: (x :f64, y :f64) :bool {
    return SDL_WarpMouseGlobal(x, y)
}

pub fn capture_mouse: (enabled :bool) :bool {
    return SDL_CaptureMouse(enabled)
}

pub fn button_left: () :i64 { return 1 }
pub fn button_middle: () :i64 { return 2 }
pub fn button_right: () :i64 { return 4 }
pub fn button_x1: () :i64 { return 8 }
pub fn button_x2: () :i64 { return 16 }
