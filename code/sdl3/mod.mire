module sdl3

load sdl::sdl3::video
load sdl::sdl3::render
load sdl::sdl3::events
load sdl::sdl3::audio
load sdl::sdl3::clipboard
load sdl::sdl3::timer
load sdl::sdl3::version
load sdl::sdl3::power
load sdl::sdl3::filesystem
load sdl::sdl3::keyboard
load sdl::sdl3::mouse
load sdl::sdl3::messagebox
load sdl::sdl3::system
load sdl::sdl3::misc
load sdl::sdl3::cpuinfo
load sdl::sdl3::structs
load sdl::sdl3::font
load sdl::sdl3::joystick
load sdl::sdl3::gamepad
load sdl::sdl3::haptic
load sdl::sdl3::sensor

extern lib "SDL3"

extern fn SDL_Init: (flags :i64) :bool lib "SDL3"
extern fn SDL_Quit: () lib "SDL3"
extern fn SDL_GetError: () :str lib "SDL3"
extern fn SDL_Delay: (ms :i64) lib "SDL3"
extern fn SDL_GetTicks: () :i64 lib "SDL3"
extern fn SDL_GetTicksNS: () :i64 lib "SDL3"

extern fn SDL_SetHint: (name :str, value :str) :bool lib "SDL3"
extern fn SDL_GetHint: (name :str) :str lib "SDL3"

// ── Init flags ─────────────────────────────────────────────────────
pub fn init_timer: () :i64 { return 0x00000001 }
pub fn init_audio: () :i64 { return 0x00000010 }
pub fn init_video: () :i64 { return 0x00000020 }
pub fn init_joystick: () :i64 { return 0x00000200 }
pub fn init_gamepad: () :i64 { return 0x00002000 }
pub fn init_events: () :i64 { return 0x00004000 }
pub fn init_sensor: () :i64 { return 0x00008000 }
pub fn init_camera: () :i64 { return 0x00010000 }
pub fn init_everything: () :i64 { return 0x0000003F }

pub fn init: (flags :i64) :bool { return SDL_Init(flags) }

pub fn quit: () { SDL_Quit() }

pub fn get_error: () :str { return SDL_GetError() }

pub fn delay: (ms :i64) { SDL_Delay(ms) }

pub fn get_ticks: () :i64 { return SDL_GetTicks() }

pub fn get_ticks_ns: () :i64 { return SDL_GetTicksNS() }

pub fn set_hint: (name :str, value :str) :bool { return SDL_SetHint(name, value) }

pub fn get_hint: (name :str) :str { return SDL_GetHint(name) }
