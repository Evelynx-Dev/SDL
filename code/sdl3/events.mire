module events

extern lib "SDL3"

extern fn SDL_PollEvent: (event_ptr :i64) :bool lib "SDL3"
extern fn SDL_WaitEvent: (event_ptr :i64) :bool lib "SDL3"
extern fn SDL_WaitEventTimeout: (event_ptr :i64, timeout_ms :i64) :bool lib "SDL3"
extern fn SDL_PushEvent: (event_ptr :i64) :bool lib "SDL3"
extern fn SDL_FlushEvent: (event_type :i64) lib "SDL3"
extern fn SDL_FlushEvents: (min_type :i64, max_type :i64) lib "SDL3"

extern fn rt_alloc_raw: (size :i64) :i64 lib "c"
extern fn rt_free_raw: (ptr :i64) lib "c"
extern fn rt_read_u8: (ptr :i64) :i64 lib "c"
extern fn rt_read_u16: (ptr :i64) :i64 lib "c"
extern fn rt_read_u32: (ptr :i64) :i64 lib "c"
extern fn rt_read_i32: (ptr :i64) :i64 lib "c"
extern fn rt_read_u64: (ptr :i64) :i64 lib "c"
extern fn rt_read_ptr: (ptr :i64) :i64 lib "c"
extern fn rt_read_f32: (ptr :i64) :f64 lib "c"
extern fn rt_read_cstr: (ptr :i64) :str lib "c"
extern fn rt_write_i32: (ptr :i64, val :i64) lib "c"

// ── SDL3 event type constants (SDL_EventType enum) ──────────────────
pub fn event_type_quit: () :i64 { return 0x100 }
pub fn event_type_window_event: () :i64 { return 0x200 }
pub fn event_type_key_down: () :i64 { return 0x300 }
pub fn event_type_key_up: () :i64 { return 0x301 }
pub fn event_type_text_input: () :i64 { return 0x303 }
pub fn event_type_text_editing: () :i64 { return 0x304 }
pub fn event_type_text_editing_candidates: () :i64 { return 0x305 }
pub fn event_type_mouse_motion: () :i64 { return 0x400 }
pub fn event_type_mouse_button_down: () :i64 { return 0x401 }
pub fn event_type_mouse_button_up: () :i64 { return 0x402 }
pub fn event_type_mouse_wheel: () :i64 { return 0x403 }
pub fn event_type_finger_down: () :i64 { return 0x700 }
pub fn event_type_finger_up: () :i64 { return 0x701 }
pub fn event_type_finger_motion: () :i64 { return 0x702 }
pub fn event_type_finger_canceled: () :i64 { return 0x703 }
pub fn event_type_clipboard_update: () :i64 { return 0x600 }
pub fn event_type_drop_file: () :i64 { return 0x1000 }
pub fn event_type_drop_text: () :i64 { return 0x1001 }
pub fn event_type_drop_begin: () :i64 { return 0x1002 }
pub fn event_type_drop_complete: () :i64 { return 0x1003 }
pub fn event_type_drop_position: () :i64 { return 0x1004 }
pub fn event_type_audio_device_added: () :i64 { return 0x1100 }
pub fn event_type_audio_device_removed: () :i64 { return 0x1101 }
pub fn event_type_audio_device_format_changed: () :i64 { return 0x1102 }
pub fn event_type_display_orientation: () :i64 { return 0x151 }
pub fn event_type_display_added: () :i64 { return 0x152 }
pub fn event_type_display_removed: () :i64 { return 0x153 }
pub fn event_type_display_moved: () :i64 { return 0x154 }
pub fn event_type_display_desktop_mode_changed: () :i64 { return 0x155 }
pub fn event_type_display_current_mode_changed: () :i64 { return 0x156 }
pub fn event_type_display_content_scale_changed: () :i64 { return 0x157 }
pub fn event_type_display_usable_bounds_changed: () :i64 { return 0x158 }
pub fn event_type_joystick_axis_motion: () :i64 { return 0x600 }
pub fn event_type_joystick_ball_motion: () :i64 { return 0x601 }
pub fn event_type_joystick_hat_motion: () :i64 { return 0x602 }
pub fn event_type_joystick_button_down: () :i64 { return 0x603 }
pub fn event_type_joystick_button_up: () :i64 { return 0x604 }
pub fn event_type_joystick_added: () :i64 { return 0x605 }
pub fn event_type_joystick_removed: () :i64 { return 0x606 }
pub fn event_type_joystick_battery_updated: () :i64 { return 0x607 }
pub fn event_type_joystick_update_complete: () :i64 { return 0x608 }
pub fn event_type_gamepad_axis_motion: () :i64 { return 0x650 }
pub fn event_type_gamepad_button_down: () :i64 { return 0x651 }
pub fn event_type_gamepad_button_up: () :i64 { return 0x652 }
pub fn event_type_gamepad_added: () :i64 { return 0x653 }
pub fn event_type_gamepad_removed: () :i64 { return 0x654 }
pub fn event_type_gamepad_remapped: () :i64 { return 0x655 }
pub fn event_type_gamepad_touchpad_down: () :i64 { return 0x656 }
pub fn event_type_gamepad_touchpad_motion: () :i64 { return 0x657 }
pub fn event_type_gamepad_touchpad_up: () :i64 { return 0x658 }
pub fn event_type_gamepad_sensor_update: () :i64 { return 0x659 }
pub fn event_type_sensor_update: () :i64 { return 0x1200 }
pub fn event_type_render_targets_reset: () :i64 { return 0x2000 }
pub fn event_type_render_device_reset: () :i64 { return 0x2001 }
pub fn event_type_render_device_lost: () :i64 { return 0x2002 }
pub fn event_type_user_event: () :i64 { return 0x8000 }

// ── Window event types (SDL3 SDL_EventType values) ────────────────
// In SDL3 there is no window-event subtype: the event type itself is
// SDL_EVENT_WINDOW_* = 0x200 + N, and data1/data2 carry the payload.
pub fn window_event_shown: () :i64 { return 0x202 }
pub fn window_event_hidden: () :i64 { return 0x203 }
pub fn window_event_exposed: () :i64 { return 0x204 }
pub fn window_event_moved: () :i64 { return 0x205 }
pub fn window_event_resized: () :i64 { return 0x206 }
pub fn window_event_pixel_size_changed: () :i64 { return 0x207 }
pub fn window_event_minimized: () :i64 { return 0x209 }
pub fn window_event_maximized: () :i64 { return 0x20A }
pub fn window_event_restored: () :i64 { return 0x20B }
pub fn window_event_mouse_enter: () :i64 { return 0x20C }
pub fn window_event_mouse_leave: () :i64 { return 0x20D }
pub fn window_event_focus_gained: () :i64 { return 0x20E }
pub fn window_event_focus_lost: () :i64 { return 0x20F }
pub fn window_event_close_requested: () :i64 { return 0x210 }
pub fn window_event_hit_test: () :i64 { return 0x211 }
pub fn window_event_iccp_changed: () :i64 { return 0x212 }
pub fn window_event_display_changed: () :i64 { return 0x213 }
pub fn window_event_display_scale_changed: () :i64 { return 0x214 }
pub fn window_event_safe_area_changed: () :i64 { return 0x215 }
pub fn window_event_occluded: () :i64 { return 0x216 }
pub fn window_event_enter_fullscreen: () :i64 { return 0x217 }
pub fn window_event_leave_fullscreen: () :i64 { return 0x218 }
pub fn window_event_destroyed: () :i64 { return 0x219 }

// ── SDL_Event allocation ───────────────────────────────────────────
// SDL_Event is a 128-byte union on x86_64. Allocate once and reuse.
pub fn event_size: () :i64 { return 128 }

pub fn allocate_event: () :i64 {
    set ptr = rt_alloc_raw(use! events::event_size())
    return ptr
}

pub fn free_event: (ptr :i64) {
    if ptr != 0 { rt_free_raw(ptr) }
}

// ── Event polling wrappers ─────────────────────────────────────────
pub fn poll_event: (buf :i64) :bool { return SDL_PollEvent(buf) }

pub fn wait_event: (buf :i64) :bool { return SDL_WaitEvent(buf) }

pub fn wait_event_timeout: (buf :i64, ms :i64) :bool { return SDL_WaitEventTimeout(buf, ms) }

pub fn push_event: (buf :i64) :bool { return SDL_PushEvent(buf) }

pub fn flush_event: (t :i64) { SDL_FlushEvent(t) }

pub fn flush_events: (min :i64, max :i64) { SDL_FlushEvents(min, max) }

// ── Generic event field reads ──────────────────────────────────────
// Every SDL3 event struct starts with:
//   offset  0: type (Uint32)
//   offset  4: reserved (Uint32)
//   offset  8: timestamp (Uint64)
//   offset 16: windowID (Uint32)

pub fn event_type: (buf :i64) :i64 {
    return rt_read_u32(buf)
}

pub fn event_window_id: (buf :i64) :i64 {
    return rt_read_u32(buf + 16)
}

// ── Window event fields ────────────────────────────────────────────
// SDL_WindowEvent: data1 @ offset 20, data2 @ offset 24.
// data1/data2 carry the event payload (e.g. new width/height on RESIZED).

pub fn window_event_data1: (buf :i64) :i64 {
    return rt_read_i32(buf + 20)
}

pub fn window_event_data2: (buf :i64) :i64 {
    return rt_read_i32(buf + 24)
}

// ── Keyboard event fields ──────────────────────────────────────────
// SDL_KeyboardEvent:
//   offset 20: which (i32) — keyboard ID
//   offset 24: scancode (i32) — SDL_Scancode
//   offset 28: key (i32) — SDL_Keycode
//   offset 32: mod (u16) — SDL_Keymod
//   offset 36: down (u8) — bool
//   offset 37: repeat (u8) — bool

pub fn keyboard_scancode: (buf :i64) :i64 {
    return rt_read_i32(buf + 24)
}

pub fn keyboard_keycode: (buf :i64) :i64 {
    return rt_read_i32(buf + 28)
}

pub fn keyboard_mod: (buf :i64) :i64 {
    return rt_read_u16(buf + 32)
}

pub fn keyboard_down: (buf :i64) :bool {
    return rt_read_u8(buf + 36) != 0
}

pub fn keyboard_repeat: (buf :i64) :bool {
    return rt_read_u8(buf + 37) != 0
}

// ── Text input event fields ────────────────────────────────────────
// SDL_TextInputEvent:
//   offset  0: type (Uint32)
//   offset  4: reserved (Uint32)
//   offset  8: timestamp (Uint64)
//   offset 16: windowID (Uint32)
//   offset 20: padding (4 bytes, align ptr to 8)
//   offset 24: text (const char*) — pointer to UTF-8 string

pub fn text_input_text: (buf :i64) :str {
    set ptr = rt_read_ptr(buf + 24)
    if ptr == 0 { return "" }
    return rt_read_cstr(ptr)
}

// ── Mouse button event fields ──────────────────────────────────────
// SDL_MouseButtonEvent:
//   offset 24: button (u8) — button index
//   offset 25: down (u8) — bool
//   offset 26: clicks (u8)
//   offset 28: x (f32)
//   offset 32: y (f32)

pub fn mouse_button: (buf :i64) :i64 {
    return rt_read_u8(buf + 24)
}

pub fn mouse_down: (buf :i64) :bool {
    return rt_read_u8(buf + 25) != 0
}

pub fn mouse_clicks: (buf :i64) :i64 {
    return rt_read_u8(buf + 26)
}

pub fn mouse_x: (buf :i64) :f64 {
    return rt_read_f32(buf + 28)
}

pub fn mouse_y: (buf :i64) :f64 {
    return rt_read_f32(buf + 32)
}

// ── Mouse motion event fields ──────────────────────────────────────
// SDL_MouseMotionEvent:
//   offset 24: state (u32) — button state mask
//   offset 28: x (f32)
//   offset 32: y (f32)
//   offset 36: xrel (f32)
//   offset 40: yrel (f32)

pub fn mouse_motion_state: (buf :i64) :i64 {
    return rt_read_u32(buf + 24)
}

pub fn mouse_motion_x: (buf :i64) :f64 {
    return rt_read_f32(buf + 28)
}

pub fn mouse_motion_y: (buf :i64) :f64 {
    return rt_read_f32(buf + 32)
}

pub fn mouse_motion_xrel: (buf :i64) :f64 {
    return rt_read_f32(buf + 36)
}

pub fn mouse_motion_yrel: (buf :i64) :f64 {
    return rt_read_f32(buf + 40)
}

// ── Mouse wheel event fields ────────────────────────────────────────
// SDL_MouseWheelEvent:
//   offset 20: which (u32) — mouse instance id
//   offset 24: x (f32) — horizontal scroll amount
//   offset 28: y (f32) — vertical scroll amount
//   offset 32: direction (u32)
//   offset 36: use! events::mouse_x (f32) — cursor position
//   offset 40: use! events::mouse_y (f32)
//   offset 44: integer_x (i32) — whole scroll ticks
//   offset 48: integer_y (i32)

pub fn mouse_wheel_x: (buf :i64) :f64 {
    return rt_read_f32(buf + 24)
}

pub fn mouse_wheel_y: (buf :i64) :f64 {
    return rt_read_f32(buf + 28)
}

pub fn mouse_wheel_mouse_x: (buf :i64) :f64 {
    return rt_read_f32(buf + 36)
}

pub fn mouse_wheel_mouse_y: (buf :i64) :f64 {
    return rt_read_f32(buf + 40)
}

pub fn mouse_wheel_integer_x: (buf :i64) :i64 {
    return rt_read_i32(buf + 44)
}

pub fn mouse_wheel_integer_y: (buf :i64) :i64 {
    return rt_read_i32(buf + 48)
}

// ── Mouse button constants ─────────────────────────────────────────
pub fn mouse_left: () :i64 { return 1 }
pub fn mouse_middle: () :i64 { return 2 }
pub fn mouse_right: () :i64 { return 3 }
pub fn mouse_x1: () :i64 { return 4 }
pub fn mouse_x2: () :i64 { return 5 }

// ── Finger (touch) event fields ─────────────────────────────────────
// SDL_TouchFingerEvent:
//   offset  0: type (u32)
//   offset  4: reserved (u32)
//   offset  8: timestamp (u64)
//   offset 16: touchID (i64)
//   offset 24: fingerID (i64)
//   offset 32: x (f32) — normalized 0..1
//   offset 36: y (f32) — normalized 0..1
//   offset 40: dx (f32) — normalized -1..1
//   offset 44: dy (f32) — normalized -1..1
//   offset 48: pressure (f32) — normalized 0..1
//   offset 52: windowID (u32)

pub fn finger_touch_id: (buf :i64) :i64 {
    return rt_read_u64(buf + 16)
}

pub fn finger_id: (buf :i64) :i64 {
    return rt_read_u64(buf + 24)
}

pub fn finger_x: (buf :i64) :f64 {
    return rt_read_f32(buf + 32)
}

pub fn finger_y: (buf :i64) :f64 {
    return rt_read_f32(buf + 36)
}

pub fn finger_dx: (buf :i64) :f64 {
    return rt_read_f32(buf + 40)
}

pub fn finger_dy: (buf :i64) :f64 {
    return rt_read_f32(buf + 44)
}

pub fn finger_pressure: (buf :i64) :f64 {
    return rt_read_f32(buf + 48)
}

// ── Drop event fields ───────────────────────────────────────────────
// SDL_DropEvent:
//   offset  0: type (u32)
//   offset  4: reserved (u32)
//   offset  8: timestamp (u64)
//   offset 16: windowID (u32)
//   offset 20: padding
//   offset 24: x (f32)
//   offset 28: y (f32)
//   offset 32: source (ptr)
//   offset 40: data (ptr)

pub fn drop_x: (buf :i64) :f64 {
    return rt_read_f32(buf + 24)
}

pub fn drop_y: (buf :i64) :f64 {
    return rt_read_f32(buf + 28)
}

pub fn drop_source: (buf :i64) :str {
    set ptr = rt_read_ptr(buf + 32)
    if ptr == 0 { return "" }
    return rt_read_cstr(ptr)
}

pub fn drop_data: (buf :i64) :str {
    set ptr = rt_read_ptr(buf + 40)
    if ptr == 0 { return "" }
    return rt_read_cstr(ptr)
}

// ── Display event fields ────────────────────────────────────────────
// SDL_DisplayEvent:
//   offset  0: type (u32)
//   offset  4: reserved (u32)
//   offset  8: timestamp (u64)
//   offset 16: displayID (u32)
//   offset 20: data1 (i32)
//   offset 24: data2 (i32)

pub fn display_event_id: (buf :i64) :i64 {
    return rt_read_u32(buf + 16)
}

pub fn display_event_data1: (buf :i64) :i64 {
    return rt_read_i32(buf + 20)
}

pub fn display_event_data2: (buf :i64) :i64 {
    return rt_read_i32(buf + 24)
}

// ── Audio device event fields ───────────────────────────────────────
// SDL_AudioDeviceEvent:
//   offset  0: type (u32)
//   offset  4: reserved (u32)
//   offset  8: timestamp (u64)
//   offset 16: which (u32) — device ID
//   offset 20: recording (u8) — bool

pub fn audio_device_which: (buf :i64) :i64 {
    return rt_read_u32(buf + 16)
}

pub fn audio_device_recording: (buf :i64) :bool {
    return rt_read_u8(buf + 20) != 0
}

// ── Joystick event fields ───────────────────────────────────────────
// SDL_JoyAxisEvent:
//   offset 16: which (i64) — joystick instance id
//   offset 24: axis (u8)
//   offset 28: value (i16)
pub fn joystick_axis_which: (buf :i64) :i64 { return rt_read_u64(buf + 16) }
pub fn joystick_axis_index: (buf :i64) :i64 { return rt_read_u8(buf + 24) }
pub fn joystick_axis_value: (buf :i64) :i64 { return rt_read_u16(buf + 28) }

// SDL_JoyHatEvent:
//   offset 16: which (i64)
//   offset 24: hat (u8)
//   offset 25: value (u8)
pub fn joystick_hat_which: (buf :i64) :i64 { return rt_read_u64(buf + 16) }
pub fn joystick_hat_index: (buf :i64) :i64 { return rt_read_u8(buf + 24) }
pub fn joystick_hat_value: (buf :i64) :i64 { return rt_read_u8(buf + 25) }

// SDL_JoyButtonEvent:
//   offset 16: which (i64)
//   offset 24: button (u8)
//   offset 25: down (u8) — bool
pub fn joystick_button_which: (buf :i64) :i64 { return rt_read_u64(buf + 16) }
pub fn joystick_button_index: (buf :i64) :i64 { return rt_read_u8(buf + 24) }
pub fn joystick_button_down: (buf :i64) :bool { return rt_read_u8(buf + 25) != 0 }

// SDL_JoyDeviceEvent:
//   offset 16: which (i64)
pub fn joystick_device_which: (buf :i64) :i64 { return rt_read_u64(buf + 16) }

// ── Gamepad event fields ────────────────────────────────────────────
// SDL_GamepadAxisEvent:
//   offset 16: which (i64)
//   offset 24: axis (u8)
//   offset 28: value (i16)
pub fn gamepad_axis_which: (buf :i64) :i64 { return rt_read_u64(buf + 16) }
pub fn gamepad_axis_index: (buf :i64) :i64 { return rt_read_u8(buf + 24) }
pub fn gamepad_axis_value: (buf :i64) :i64 { return rt_read_u16(buf + 28) }

// SDL_GamepadButtonEvent:
//   offset 16: which (i64)
//   offset 24: button (u8)
//   offset 25: down (u8) — bool
pub fn gamepad_button_which: (buf :i64) :i64 { return rt_read_u64(buf + 16) }
pub fn gamepad_button_index: (buf :i64) :i64 { return rt_read_u8(buf + 24) }
pub fn gamepad_button_down: (buf :i64) :bool { return rt_read_u8(buf + 25) != 0 }

// SDL_GamepadDeviceEvent:
//   offset 16: which (i64)
pub fn gamepad_device_which: (buf :i64) :i64 { return rt_read_u64(buf + 16) }

// ── Sensor event fields ─────────────────────────────────────────────
// SDL_SensorEvent:
//   offset 16: which (i64) — sensor instance id
//   offset 24: sensor_timestamp (u64)
//   offset 32: data[6] (f32 × 6) — sensor data values
pub fn sensor_which: (buf :i64) :i64 { return rt_read_u64(buf + 16) }
pub fn sensor_timestamp: (buf :i64) :i64 { return rt_read_u64(buf + 24) }
pub fn sensor_data: (buf :i64, idx :i64) :f64 { return rt_read_f32(buf + 32 + idx * 4) }

// ── Joystick hat constants ──────────────────────────────────────────
pub fn hat_centered: () :i64 { return 0x00 }
pub fn hat_up: () :i64 { return 0x01 }
pub fn hat_right: () :i64 { return 0x02 }
pub fn hat_down: () :i64 { return 0x04 }
pub fn hat_left: () :i64 { return 0x08 }
pub fn hat_rightup: () :i64 { return 0x03 }
pub fn hat_rightdown: () :i64 { return 0x06 }
pub fn hat_leftup: () :i64 { return 0x09 }
pub fn hat_leftdown: () :i64 { return 0x0C }
