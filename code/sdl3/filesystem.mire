module filesystem

extern lib "SDL3"

extern fn SDL_GetBasePath: () :str lib "SDL3"
extern fn SDL_GetPrefPath: (org :str, app :str) :str lib "SDL3"
extern fn SDL_GetCurrentDirectory: () :str lib "SDL3"
extern fn SDL_GetUserFolder: (folder :i64) :str lib "SDL3"
extern fn SDL_CreateDirectory: (path :str) :bool lib "SDL3"
extern fn SDL_RemovePath: (path :str) :bool lib "SDL3"
extern fn SDL_RenamePath: (oldpath :str, newpath :str) :bool lib "SDL3"
extern fn SDL_CopyFile: (oldpath :str, newpath :str) :bool lib "SDL3"

pub fn folder_home: () :i64 { return 0 }
pub fn folder_desktop: () :i64 { return 1 }
pub fn folder_documents: () :i64 { return 2 }
pub fn folder_downloads: () :i64 { return 3 }
pub fn folder_music: () :i64 { return 4 }
pub fn folder_pictures: () :i64 { return 5 }
pub fn folder_publicshare: () :i64 { return 6 }
pub fn folder_savedgames: () :i64 { return 7 }
pub fn folder_screenshots: () :i64 { return 8 }

pub fn get_base_path: () :str {
    return SDL_GetBasePath()
}

pub fn get_pref_path: (org :str, app :str) :str {
    return SDL_GetPrefPath(org, app)
}

pub fn get_current_directory: () :str {
    return SDL_GetCurrentDirectory()
}

pub fn get_user_folder: (folder :i64) :str {
    return SDL_GetUserFolder(folder)
}

pub fn create_directory: (path :str) :bool {
    return SDL_CreateDirectory(path)
}

pub fn remove_path: (path :str) :bool {
    return SDL_RemovePath(path)
}

pub fn rename_path: (oldpath :str, newpath :str) :bool {
    return SDL_RenamePath(oldpath, newpath)
}

pub fn copy_file: (oldpath :str, newpath :str) :bool {
    return SDL_CopyFile(oldpath, newpath)
}
