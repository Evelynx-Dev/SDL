load kioto
load sdl::sdl2

@[test] pub fn sdl2_cpu_cores_positive: () :bool {
    return cpuinfo::get_cpu_count() > 0
}

@[test] pub fn sdl2_cpu_ram_positive: () :bool {
    return cpuinfo::get_num_system_ram() > 0
}

@[test] pub fn sdl2_base_path_not_empty: () :bool {
    set p = filesystem::get_base_path()
    return strings::len(p) > 0
}

@[test] pub fn sdl2_pref_path_not_empty: () :bool {
    set p = filesystem::get_pref_path("owl_test", "sdl2_probe")
    return strings::len(p) > 0
}

@[test] pub fn sdl2_platform_not_empty: () :bool {
    set p = system::get_platform()
    return strings::len(p) > 0
}

@[test] pub fn sdl2_power_state_valid: () :bool {
    set st = power::get_power_info(0, 0)
    return st == power::state_unknown() || st == power::state_on_battery() || st == power::state_no_battery() || st == power::state_charging() || st == power::state_charged()
}

@[test] pub fn sdl2_keyboard_key_from_name: () :bool {
    set key = keyboard::get_key_from_name("a")
    return key > 0
}

@[test] pub fn sdl2_keyboard_scancode_name: () :bool {
    set name = keyboard::get_scancode_name(4)
    return strings::len(name) > 0
}
